{
  "name": "inkstone-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup.ts",
    "db:seed": "npm run db:setup -- --seed",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  }
}
